{
  "fps": 30,
  "frames": 1754,
  "cues": [
    {
      "id": "b1-01.1",
      "speaker": "arjun",
      "text": "At seven forty-six on a Tuesday morning, a customer reported that they couldn't get into their Atlassian site.",
      "start": 0,
      "end": 227
    },
    {
      "id": "b1-01.2",
      "speaker": "arjun",
      "text": "Eight minutes earlier, a maintenance job had started.",
      "start": 231,
      "end": 348
    },
    {
      "id": "b1-01.3",
      "speaker": "arjun",
      "text": "It was supposed to remove an old app.",
      "start": 353,
      "end": 437
    },
    {
      "id": "b1-01.4",
      "speaker": "arjun",
      "text": "The job was still running when the ticket came in.",
      "start": 441,
      "end": 544
    },
    {
      "id": "b1-02.1",
      "speaker": "sam",
      "text": "Their whole team uses that address.",
      "start": 569,
      "end": 664
    },
    {
      "id": "b1-02.2",
      "speaker": "sam",
      "text": "What do I tell them to open instead?",
      "start": 668,
      "end": 756
    },
    {
      "id": "b1-03.1",
      "speaker": "arjun",
      "text": "I can tell you what we were trying to remove.",
      "start": 777,
      "end": 875
    },
    {
      "id": "b1-03.2",
      "speaker": "arjun",
      "text": "I need to check what we actually touched.",
      "start": 879,
      "end": 964
    },
    {
      "id": "b1-04.1",
      "speaker": "arjun",
      "text": "By eight oh one, the script had deleted eight hundred and eighty-three cloud sites.",
      "start": 973,
      "end": 1144
    },
    {
      "id": "b1-04.2",
      "speaker": "arjun",
      "text": "Seven hundred and seventy-five customers were affected.",
      "start": 1149,
      "end": 1275
    },
    {
      "id": "b1-04.3",
      "speaker": "arjun",
      "text": "For some of them, getting back in took up to fourteen days.",
      "start": 1280,
      "end": 1403
    },
    {
      "id": "b1-04.4",
      "speaker": "arjun",
      "text": "The first production batch had worked.",
      "start": 1407,
      "end": 1491
    },
    {
      "id": "b1-04.5",
      "speaker": "arjun",
      "text": "To see what changed, we need to see what that first batch actually proved.",
      "start": 1495,
      "end": 1649
    }
  ],
